# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/sandhyasolar

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS - Frontend URL (comma-separated for multiple origins, no trailing slashes)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Super Admin (used by: npm run create-super-admin)
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_EMAIL=admin@sandhyasolar.com
SUPER_ADMIN_PASSWORD=change_this_secure_password
